{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "aureon",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": [
        "main:app",
        "--port",
        "8077"
      ],
      "port": 8077
    },
    {
      "name": "aureon-verify",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": [
        "main:app",
        "--port",
        "8088"
      ],
      "port": 8088,
      "env": {
        "DATA_MODE": "live"
      }
    }
  ]
}
